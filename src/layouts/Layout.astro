---
import { asset } from '../lib/url.js';
import '../styles/global.css';
const { title = 'Healpy S.A. | Proyecto Divercity' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Healpy S.A. presenta Divercity: accesibilidad urbana y vial en la Estación de Banfield. Sumate, donás y aportá." />
    <link rel="icon" href={asset('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={asset('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body><slot /></body>
</html>
